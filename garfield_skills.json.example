{
  "version": 2,
  "skills": [
    {
      "id": "example_search",
      "phrases": [
        "гугл {query}"
      ],
      "action_id": "web.search",
      "arguments": {
        "query": "{query}"
      },
      "response": "Ищу: {query}."
    },
    {
      "id": "example_url",
      "phrases": [
        "открой мой сайт"
      ],
      "action_id": "web.open",
      "arguments": {
        "url": "https://example.com"
      },
      "response": "Открываю сайт."
    },
    {
      "id": "example_app",
      "phrases": [
        "открой калькулятор"
      ],
      "action_id": "application.open",
      "arguments": {
        "app_id": "calculator"
      },
      "response": "Открываю калькулятор."
    }
  ]
}
