{
  "version": 2,
  "skills": [
    {
      "id": "google_search",
      "phrases": [
        "гугл {query}",
        "поищи в гугле {query}",
        "найди в интернете {query}"
      ],
      "action_id": "web.search",
      "arguments": {
        "query": "{query}"
      },
      "response": "Ищу в интернете: {query}."
    },
    {
      "id": "youtube_search",
      "phrases": [
        "ютуб {query}",
        "найди на ютубе {query}",
        "youtube {query}"
      ],
      "action_id": "web.open",
      "arguments": {
        "url": "https://www.youtube.com/results?search_query={query_url}"
      },
      "response": "Ищу на YouTube: {query}."
    },
    {
      "id": "open_nvidia_build",
      "phrases": [
        "открой nvidia build",
        "открой build nvidia",
        "открой студию nvidia"
      ],
      "action_id": "web.open",
      "arguments": {
        "url": "https://build.nvidia.com"
      },
      "response": "Открываю NVIDIA Build."
    },
    {
      "id": "open_project_folder",
      "phrases": [
        "открой папку гарфилда",
        "открой рабочую папку гарфилда"
      ],
      "action_id": "project_file.open",
      "arguments": {
        "path": "."
      },
      "response": "Открываю папку проекта."
    },
    {
      "id": "open_logs",
      "phrases": [
        "открой лог гарфилда",
        "покажи лог гарфилда"
      ],
      "action_id": "project_file.open",
      "arguments": {
        "path": "garfield_flagship.log"
      },
      "response": "Открываю лог приложения."
    },
    {
      "id": "open_calculator",
      "phrases": [
        "открой калькулятор",
        "запусти калькулятор"
      ],
      "action_id": "application.open",
      "arguments": {
        "app_id": "calculator"
      },
      "response": "Открываю калькулятор."
    }
  ]
}
